# Copy this file to `.env` and fill in real values. Never commit `.env`.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tag-x
R2_PUBLIC_URL=

# Brevo (transactional email)
BREVO_API_KEY=
BREVO_FROM_EMAIL=founder@mulsetu.com
BREVO_FROM_NAME=TagX

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional inbox for demo/inquire CRM notifications (defaults to BREVO_FROM_EMAIL)
CRM_NOTIFY_EMAIL=

# Razorpay (dashboard → API Keys + Webhooks)
# Webhook URL: https://your-domain/api/razorpay/webhook
# Events: payment.captured, order.paid, subscription.activated, subscription.charged,
#         subscription.pending, subscription.halted, subscription.cancelled
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required for GET/POST /api/cron/notifications (Authorization: Bearer <secret>).
# Missing CRON_SECRET returns 401. In-process rate limits are single-instance only
# (multi-instance needs Redis — TAGX-019).
CRON_SECRET=
