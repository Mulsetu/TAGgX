# Supabase (new sb_publishable_/sb_secret_ API keys, not the legacy anon/service_role JWTs)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket (custom domain or the pub-*.r2.dev one) —
# uploaded file URLs are built as `${R2_PUBLIC_URL}/${key}`.
R2_PUBLIC_URL=

# Brevo (transactional email, via their HTTP API — not SMTP)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=TagX
# Set to "true" to force real Brevo sends in non-production too. Left
# unset/false, invite emails aren't sent in development — the setup link
# is returned directly in the response instead (see modules/email).
SEND_REAL_EMAILS_IN_DEV=false

# Base URL used to build links inside emails (invite links, asset links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
